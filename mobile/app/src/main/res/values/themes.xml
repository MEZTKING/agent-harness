<resources>
    <!--
      Eclipse: the dark floor behind the app while it starts. Dark in every case: the look (Eclipse, Pitch or
      Ash) is chosen inside the app, not by the phone's light or dark setting.
    -->
    <style name="Theme.Roundtable" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/eclipse_background</item>
        <item name="android:statusBarColor">@color/eclipse_background</item>
        <item name="android:navigationBarColor">@color/eclipse_background</item>
        <item name="android:colorAccent">@color/eclipse_accent</item>
    </style>
</resources>
