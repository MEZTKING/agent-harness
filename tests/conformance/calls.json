{
 "about": "Every call Roundtable Mobile makes to the PC (mobile/app/src/main/java/**.kt). tests/conformance/test_phone_calls.py runs each against a real phone server and writes the answers to mobile/app/src/test/resources/conformance/<name>.json (ROUNDTABLE_WRITE_FIXTURES=1); ConformanceTest.kt reads them with the app's own decoders. Placeholders in braces are filled from a made-up project. 'needs' are the keys the phone reads; 'local' calls are only made to Roundtable on the phone itself; 'save' keeps a value from the answer for later calls.",
 "exempt": [
  "/api/ping",
  "/api/changes",
  "/api/pair/claim",
  "/api/health",
  "/api/keys"
 ],
 "calls": [
  {
   "name": "ping",
   "method": "GET",
   "path": "/api/ping",
   "needs": [
    "name",
    "version",
    "device"
   ]
  },
  {
   "name": "changes",
   "method": "GET",
   "path": "/api/changes",
   "query": {
    "since": "",
    "wait": "0"
   },
   "needs": [
    "version",
    "changed"
   ]
  },
  {
   "name": "roundtable",
   "method": "GET",
   "path": "/api/roundtable",
   "needs": [
    "seats",
    "needs_you"
   ]
  },
  {
   "name": "activity",
   "method": "GET",
   "path": "/api/activity",
   "query": {
    "limit": "120"
   },
   "shape": "list"
  },
  {
   "name": "project",
   "method": "GET",
   "path": "/api/project",
   "query": {
    "path": "{project}"
   },
   "needs": [
    "meta",
    "tasks"
   ]
  },
  {
   "name": "chat",
   "method": "GET",
   "path": "/api/chat",
   "query": {
    "path": "{project}"
   },
   "shape": "list"
  },
  {
   "name": "inbox",
   "method": "GET",
   "path": "/api/inbox/{agent}",
   "shape": "list"
  },
  {
   "name": "inbox_all",
   "method": "GET",
   "path": "/api/inbox/{agent}",
   "query": {
    "all": "1"
   },
   "shape": "list"
  },
  {
   "name": "journal",
   "method": "GET",
   "path": "/api/journal/{agent}",
   "shape": "list"
  },
  {
   "name": "jobs",
   "method": "GET",
   "path": "/api/jobs",
   "shape": "list"
  },
  {
   "name": "asks",
   "method": "GET",
   "path": "/api/asks",
   "query": {
    "path": "{project}"
   }
  },
  {
   "name": "notes",
   "method": "GET",
   "path": "/api/notes",
   "needs": [
    "notes"
   ]
  },
  {
   "name": "note",
   "method": "GET",
   "path": "/api/note",
   "query": {
    "name": "{note}"
   },
   "needs": [
    "markdown"
   ]
  },
  {
   "name": "plan",
   "method": "GET",
   "path": "/api/plan",
   "query": {
    "path": "{project}"
   },
   "needs": [
    "words"
   ]
  },
  {
   "name": "live",
   "method": "GET",
   "path": "/api/project/live",
   "query": {
    "inline": "1",
    "path": "{project}"
   }
  },
  {
   "name": "session",
   "method": "GET",
   "path": "/api/project/session",
   "query": {
    "compact": "1",
    "path": "{project}"
   }
  },
  {
   "name": "files",
   "method": "GET",
